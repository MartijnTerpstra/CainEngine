{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "description": "Visual Studio generator, x64, multi-config (build type picked at build time)",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/_build/CainEngine/${presetName}",
      "installDir": "${sourceDir}/_install/CainEngine/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "BUILD_TESTING": {
          "type": "BOOL",
          "value": true
        }
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ]
        }
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "description": "Ninja generator, Release build (MSVC-only optimizer flags per top-level CMakeLists.txt)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build/CainEngine/${presetName}",
      "installDir": "${sourceDir}/_install/CainEngine/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": {
          "type": "BOOL",
          "value": false
        },
        "MST_RUN_TESTS": {
          "type": "BOOL",
          "value": false
        }
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ]
        }
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 Debug",
      "description": "Unix Makefiles generator, Debug build; targets WSL or a remote Linux connection selected via the VS Target System dropdown",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/_build/CainEngine/${presetName}",
      "installDir": "${sourceDir}/_install/CainEngine/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MST_CREATE_LIBRARY": "ON"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Linux" ]
        },
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}",
          "copySourcesOptions": {
            "exclusionList": [ ".vs", ".git", ".svn", "_build", "_install", "build", "build_verify", "out" ],
            "concurrentCopies": 10
          }
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 Debug",
      "configurePreset": "linux-x64-debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 Debug",
      "configurePreset": "linux-x64-debug"
    }
  ]
}
